    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch Verifier",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceRoot}/verifierOperator"
        },
        {
            "name": "Launch Verifier CLI",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceRoot}/verifierOperator/cli",
            "args": ["regEl"]
        },
        {
            "name": "Launch Aggregator",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceRoot}/aggregatorService",
        }
    ]
}