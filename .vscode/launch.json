    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch Verifier",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceRoot}/verifier",
            // "buildFlags": ["-config=config.yaml"],
            "args": ["-config","config.yaml"],
            "showLog": false
        },
        {
            "name": "Launch Verifier CLI",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceRoot}/verifier/cli",
            "args": ["regEl"]
        },
        {
            "name": "Launch Aggregator",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceRoot}/aggregator",
            "args": ["-config","config.yaml"],
        }
    ]
}